# Environment Variables for the Blockchain Full-Stack Application

# Next.js Frontend Configuration
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id_here
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://eth.llamarpc.com
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Smart Contract Configuration (Update after deployment)
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_NETWORK_NAME=localhost
NEXT_PUBLIC_CONTRACT_NAME=BlockchainNFT

# Backend API Configuration
BACKEND_URL=http://localhost:3001

# Backend Environment Variables (for backend/.env)
# Copy these to backend/.env file
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ETHEREUM_RPC_URL=https://eth.llamarpc.com
SEPOLIA_RPC_URL=https://rpc.sepolia.org
ETHERSCAN_API_KEY=your_etherscan_api_key_here
ALCHEMY_API_KEY=your_alchemy_api_key_here
REDIS_URL=redis://localhost:6379
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blockchain_app
DB_USER=postgres
DB_PASSWORD=password

# Smart Contract Deployment (for contracts/.env)
# Copy these to contracts/.env file
PRIVATE_KEY=your_private_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here